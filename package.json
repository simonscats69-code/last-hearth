{
  "name": "last-hearth-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Постапокалиптический survival RPG Telegram Mini App - Monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run -ws -- build",
    "dev": "npm run -ws -- dev",
    "build:all": "npm run -ws -- build",
    "test": "npm run -ws -- test",
    "lint": "npm run -ws -- lint",
    "db:migrate": "npm run -w @last-hearth/db -- migrate",
    "db:seed": "npm run -w @last-hearth/db -- seed",
    "dev:server": "npm run -w @last-hearth/server -- dev",
    "dev:client": "npm run -w @last-hearth/client -- dev",
    "test:unit": "npm run -ws -- test:unit",
    "test:integration": "npm run -ws -- test:integration",
    "typecheck": "npm run -ws -- typecheck",
    "clean": "npm run -ws -- clean"
  },
  "dependencies": {
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "@types/node": "^20.11.0",
    "vitest": "^1.3.0",
    "tsx": "^4.7.0",
    "tsup": "^8.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
