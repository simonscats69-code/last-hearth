{
  "name": "last-hearth-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Постапокалиптический survival RPG Telegram Mini App - Monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node index.js",
    "postinstall": "npm run build",
    "build": "npm run -ws -- build",
    "dev": "npm run -ws -- dev",
    "build:all": "npm run -ws -- build",
    "test": "npm run -ws -- test && npm run test:root",
    "test:root": "node tests/db-init.test.js",
    "lint": "npm run -ws -- lint && npm run lint:root",
    "lint:root": "eslint index.js routes/ utils/ db/ scripts/ public/game.js webhook.js",
    "db:migrate": "npm run -w @last-hearth/db -- migrate",
    "db:seed": "npm run -w @last-hearth/db -- seed",
    "dev:server": "npm run -w @last-hearth/server -- dev",
    "dev:client": "npm run -w @last-hearth/client -- dev",
    "test:unit": "npm run -ws -- test:unit",
    "test:integration": "npm run -ws -- test:integration",
    "typecheck": "npm run -ws -- typecheck",
    "clean": "npm run -ws -- clean",
    "icons": "node scripts/icon-gen",
    "icons:verify": "node scripts/icon-gen/verify.js",
    "verify": "npm run verify:data && npm run verify:routes && npm run verify:rules && npm run verify:validate && npm run verify:client-errors && npm run verify:fallbacks && npm run verify:visual && npm run verify:dead-exports && npm run verify:messages",
    "verify:data": "node scripts/verify-data.js",
    "verify:routes": "node scripts/verify-routes.js",
    "verify:rules": "node scripts/verify-rules.js",
    "verify:validate": "node scripts/verify-validate.js",
    "verify:client-errors": "node scripts/verify-client-errors.js",
    "verify:fallbacks": "node scripts/verify-fallbacks.js",
    "verify:visual": "node scripts/verify-visual.js",
    "verify:dead-exports": "node scripts/verify-dead-exports.js",
    "verify:messages": "node scripts/verify-messages.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "express-async-errors": "^3.1.1",
    "pg": "^8.11.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "@types/node": "^20.11.0",
    "vitest": "^1.3.0",
    "tsx": "^4.7.0",
    "tsup": "^8.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
