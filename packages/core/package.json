{
  "name": "@last-hearth/core",
  "version": "1.0.0",
  "description": "Shared core logic for Last Hearth - equipment rules, economy, types",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./equipment-rules": {
      "import": "./dist/equipment-rules.mjs",
      "require": "./dist/equipment-rules.js",
      "types": "./dist/equipment-rules.d.ts"
    },
    "./economy": {
      "import": "./dist/economy.mjs",
      "require": "./dist/economy.js",
      "types": "./dist/economy.d.ts"
    },
    "./types": {
      "import": "./dist/types.mjs",
      "require": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./config": {
      "import": "./dist/config.mjs",
      "require": "./dist/config.js",
      "types": "./dist/config.d.ts"
    },
    "./formulas": {
      "import": "./dist/formulas.mjs",
      "require": "./dist/formulas.js",
      "types": "./dist/formulas.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsup": "^8.0.1",
    "vitest": "^1.3.0",
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "@vitest/coverage-v8": "^1.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
