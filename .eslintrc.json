{
    "root": true,
    "env": {
        "node": true,
        "es2021": true
    },
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "script"
    },
    "extends": "eslint:recommended",
    "overrides": [
        {
            "files": ["public/game.js", "public/sw.js"],
            "env": { "browser": true, "node": false },
            "globals": {
                "Telegram": "readonly"
            }
        },
        {
            "files": ["public/shared/equipment.js"],
            "env": { "browser": true, "node": true }
        },
        {
            "files": ["tests/**/*.js"],
            "env": { "jest": true }
        }
    ],
    "rules": {
        "no-undef": "error",
        "no-unused-vars": ["error", { "args": "none", "varsIgnorePattern": "^_" }],
        "no-console": "off"
    }
}
